generator client {
  provider = "prisma-client"
  output = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Equipment {
 id String @id
 assetTag String
 serialNumber String
 model String
 type String
 status String
 locationId String
 location Location @relation(fields: [locationId], references: [id])
 purchaseDate DateTime
 warrantyEnd DateTime
 metadata Json?

 maintenance  Maintenance[]
}

model Maintenance {
  id             String   @id 
  equipmentId    String
  type           String
  scheduledAt  DateTime
  technician     String
  status         String 
  performedAt  DateTime?
  cost           String?
  notes          Json?

  equipment Equipment @relation(fields: [equipmentId], references: [id])

  @@index([equipmentId])
}

model Location {
  id        String  @id
  code      String  @unique
  name      String
  type      String
  status    String
  building  String?
  floor     String?
  room      String?
  address   String?
  metadata  Json?

  equipments Equipment[]
}
